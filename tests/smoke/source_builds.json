{
  "_comment": "Source build smoke tests \u2014 verify packages compile correctly with den prefix. Includes all tier 1 packages plus additional build-system coverage.",
  "tests": [
    {
      "name": "tree",
      "source": true,
      "type": "tool",
      "checks": [
        {
          "cmd": "bin/tree --version",
          "expect_exit": 0
        },
        {
          "cmd": "bin/tree .",
          "expect_exit": 0
        }
      ]
    },
    {
      "name": "jq",
      "source": true,
      "type": "tool",
      "checks": [
        {
          "cmd": "bin/jq --version",
          "expect_exit": 0
        },
        {
          "cmd": "bin/jq -n '{a: 1}'",
          "expect_stdout": "\"a\": 1"
        }
      ]
    },
    {
      "name": "lz4",
      "source": true,
      "type": "tool",
      "checks": [
        {
          "cmd": "bin/lz4 --version",
          "expect_exit": 0
        },
        {
          "file_exists": "lib/liblz4.dylib"
        },
        {
          "file_exists": "include/lz4.h"
        }
      ]
    },
    {
