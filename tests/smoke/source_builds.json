    {
      "name": "sqlite",
      "type": "library",
      "checks": [
        {
          "cmd": "bin/sqlite3 :memory: 'SELECT 1+1;'",
          "expect_stdout": "2"
        },
        {
          "file_exists": "lib/libsqlite3.dylib"
        },
        {
          "file_exists": "include/sqlite3.h"
        }
      ],
      "source": true
    },
    {
      "name": "node",
      "type": "runtime",
      "checks": [
        {
          "cmd": "bin/node --version",
          "expect_exit": 0
        },
        {
          "cmd": "bin/node -e \"console.log(1+1)\"",
          "expect_stdout": "2"
        },
        {
          "cmd": "bin/npm --version",
          "expect_exit": 0
        },
        {
          "cmd_in_tmpdir": "bin/npm init -y && bin/npm install is-odd && bin/node -e \"console.log(require('is-odd')(3))\"",
          "expect_stdout": "true"
        }
      ],
      "source": true
    },
    {
      "name": "python@3.13",
      "type": "runtime",
      "checks": [
        {
          "cmd": "bin/python3.13 --version",
          "expect_exit": 0
        },
        {
          "cmd": "bin/python3.13 -c \"print(2+2)\"",
          "expect_stdout": "4"
        },
        {
          "cmd": "bin/python3.13 -c \"import ssl; print(ssl.OPENSSL_VERSION)\"",
          "expect_exit": 0
        },
        {
          "cmd": "bin/python3.13 -c \"import sqlite3; c=sqlite3.connect(':memory:'); print('ok')\"",
          "expect_stdout": "ok"
        },
        {
          "cmd_in_tmpdir": "bin/python3.13 -m venv venv && venv/bin/pip install requests && venv/bin/python -c \"import requests; print(requests.__version__)\"",
          "expect_exit": 0
        }
      ],
      "source": true
    },
