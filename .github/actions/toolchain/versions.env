# Pinned build toolchain for CI and release jobs (#158). The single source of
# versions and hashes, read by .github/actions/toolchain/install.sh.
# Official release assets only; never Homebrew, never the runner image.
#
# Hash sources:
#   cmake:     Kitware's published cmake-<v>-SHA-256.txt for the release.
#   ninja:     no checksum file is published; SHA-256 computed from the
#              official GitHub release asset and cross-checked against
#              GitHub's asset digest.
#   hyperfine: as ninja.
#
# Bumping: change *_VERSION and every *_SHA256_* for that tool together.

CMAKE_VERSION=4.5.1
CMAKE_SHA256_macos_universal=e1fb288543e4eb2a410e385ecebc64323bda51f0205782f2b094ccd5d572ca2d
CMAKE_SHA256_linux_x86_64=83b71181fb62b4fe8f26067a9321448572e7a43bd04ff6c7f54a24c33698f16d
CMAKE_SHA256_linux_aarch64=3bec208f11ed96c173032eeaf97937c54dd246acefee22acd7794a6b4e70d536

NINJA_VERSION=1.13.2
NINJA_SHA256_macos_universal=c99048673aa765960a99cf10c6ddb9f1fad506099ff0a0e137ad8960a88f321b
NINJA_SHA256_linux_x86_64=5749cbc4e668273514150a80e387a957f933c6ed3f5f11e03fb30955e2bbead6
NINJA_SHA256_linux_aarch64=fd2cacc8050a7f12a16a2e48f9e06fca5c14fc4c2bee2babb67b58be17a607fc

HYPERFINE_VERSION=2.0.0
